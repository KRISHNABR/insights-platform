#!/usr/bin/env bash
# Local dev entrypoint.
#
# The four repos sit side by side and are not pip-installed, so this puts the SDK on the
# path and runs the CLI. In production the base image installs the SDK and `insights` is
# just on PATH - this script is the only thing about the local loop that is different.
#
#   ./dev up                     start the whole platform
#   ./dev status                 what is running
#   ./dev compliance-report --dataset hr.compensation
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(dirname "$HERE")"
export PYTHONPATH="$WORKSPACE/insights-sdk/src:$HERE:${PYTHONPATH:-}"
exec uv run --no-project --with pyyaml --with fastapi --with uvicorn --with httpx \
  python -m insights_sdk.cli.main "$@"
